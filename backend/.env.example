# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Database (direct connection for Alembic migrations)
DATABASE_URL=postgresql+asyncpg://postgres.your-project:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# AI / Voice Pipeline
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# CORS
CORS_ORIGINS=http://localhost:3000,https://salegoodman.vercel.app

# App
SECRET_KEY=change-this-to-a-random-secret
DEBUG=true
